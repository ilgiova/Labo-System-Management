{
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.log", "*.out", "*.toc", "*.fls", "*.fdb_latexmk",
    "*.bbl", "*.blg", "*.lof", "*.lot", "*.nav", "*.snm", "*.xdv"
  ],
  "files.exclude": {
    "**/*.synctex.gz": true,
    "**/*.synctex(busy)": true
  }
}
